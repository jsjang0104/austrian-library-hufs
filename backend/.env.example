# Copy to backend/.env for local development only.
DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-new-random-secret
# Production: DEBUG=false; provide DATABASE_URL and a strong SECRET_KEY in Render.
# Add only domains you control; comma separated, no wildcard suffixes.
ALLOWED_HOSTS=ohjigo-library.onrender.com,ohjigo-library-library.onrender.com
CORS_ALLOWED_ORIGINS=https://austrian-library-hufs.vercel.app
HF_API_TOKEN=
